#!/bin/bash
# Tinfoil Kit command line:  ./kit plan | sync | verify | status | search WORDS | test  (./kit --help lists them all)
# It runs the kit's own program for this computer, tools/tinfoilkit-*, which every download carries. A git checkout
# or GitHub's Download ZIP has none until tools/tinfoilkit/build.sh builds it from the Go source in tools/tinfoilkit:
# with Go installed, this builds it then, and again in a git checkout whose source is newer than its program.
DIR="$(cd "$(dirname "$0")" && pwd)"
KIT="$DIR"    # the kit folder: the app folder's, or a git checkout itself
case "$(basename "$DIR" | tr '[:upper:]' '[:lower:]')" in app) [ -e "$DIR/.git" ] || KIT="$(dirname "$DIR")" ;; esac
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) TK="$DIR/tools/tinfoilkit-macos-arm64" ;;
  Linux-x86_64) TK="$DIR/tools/tinfoilkit-linux-x64" ;;
  *) echo "Tinfoil Kit runs on Macs with Apple silicon and on Windows and Linux PCs (x64), not on this computer ($(uname -s) $(uname -m))." >&2
     exit 1 ;;
esac
if [ -f "$DIR/tools/tinfoilkit/build.sh" ] && command -v go >/dev/null &&
   { [ ! -f "$TK" ] || { [ -e "$DIR/.git" ] && [ -n "$(find "$DIR/tools/tinfoilkit" -type f -newer "$TK" | head -1)" ]; }; }; then
  echo "Building the kit's program from its source (tools/tinfoilkit/build.sh)..." >&2
  bash "$DIR/tools/tinfoilkit/build.sh" >&2 || echo "It didn't build." >&2
fi
if [ ! -f "$TK" ]; then
  echo "This copy of the kit doesn't have its program for this computer (tools/${TK##*/}). Download the kit from" >&2
  echo "https://tinfoilkit.com, or build the program with tools/tinfoilkit/build.sh (it needs Go: https://go.dev/dl)." >&2
  exit 1
fi
chmod +x "$TK" 2>/dev/null
# A download's files carry macOS's quarantine mark, which stops a program that Apple hasn't notarized from running.
if [ "$(uname -s)" = Darwin ]; then xattr -d com.apple.quarantine "$TK" 2>/dev/null; fi
if ! "$TK" version >/dev/null 2>&1; then
  echo "The kit's program (tools/${TK##*/}) doesn't run on this computer. Download the kit again from https://tinfoilkit.com." >&2
  exit 1
fi
exec "$TK" --root "$KIT" "$@"
