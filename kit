#!/bin/bash
# Tinfoil Kit command line:  ./kit plan | sync | verify | status | search WORDS | test
DIR="$(cd "$(dirname "$0")" && pwd)"
KIT="$DIR"    # the kit folder: the app folder's, or a git checkout itself
case "$(basename "$DIR" | tr '[:upper:]' '[:lower:]')" in app) [ -e "$DIR/.git" ] || KIT="$(dirname "$DIR")" ;; esac
# The kit's own program (tools/tinfoilkit, which releases carry built for each computer) runs the commands when it's
# here and runs on this computer. Without it, tools/kit.py does, on Python. KIT_NO_GO=1 keeps to Python.
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) TK="$DIR/tools/tinfoilkit-macos-arm64" ;;
  Linux-x86_64) TK="$DIR/tools/tinfoilkit-linux-x64" ;;
  *) TK="" ;;
esac
if [ -z "$KIT_NO_GO" ] && [ -n "$TK" ] && [ -f "$TK" ]; then
  chmod +x "$TK" 2>/dev/null
  if [ "$(uname -s)" = Darwin ]; then xattr -d com.apple.quarantine "$TK" 2>/dev/null; fi
  "$TK" version >/dev/null 2>&1 && exec "$TK" --root "$KIT" "$@"
fi
# The Python SETUP got for a Mac without one, or else python3. Until Apple's developer tools are installed, a Mac's
# /usr/bin/python3 only offers to install them.
PY="$HOME/Library/Application Support/TinfoilKit/python/bin/python3"
if [ ! -x "$PY" ]; then
  PY="$(command -v python3)"
  if [ "$(uname -s)" = Darwin ] && { [ -z "$PY" ] || { [ "$PY" = /usr/bin/python3 ] && ! xcode-select -p >/dev/null 2>&1; }; }; then
    echo "The kit needs Python. Double-click SETUP.command: it gets it."
    exit 1
  elif [ -z "$PY" ]; then
    echo "The kit needs python3 (3.9 or newer). Install it (Debian, Ubuntu: sudo apt install python3), then try again."
    exit 1
  fi
fi
exec "$PY" "$DIR/tools/kit.py" --root "$KIT" "$@"
