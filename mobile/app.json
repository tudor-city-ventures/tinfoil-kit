{
  "expo": {
    "name": "Tinfoil Kit",
    "slug": "tinfoil-kit",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "tinfoilkit",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F0E6",
    "ios": {
      "bundleIdentifier": "com.tinfoilkit.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Tinfoil Kit finds kits and phones on your Wi-Fi to copy books and maps from, and shares this phone's when you ask, without the internet.",
        "NSLocationWhenInUseUsageDescription": "Tinfoil Kit shows where you are on its map when you ask. Your location never leaves this phone.",
        "NSBonjourServices": ["_tinfoilkit._tcp"]
      }
    },
    "android": {
      "package": "com.tinfoilkit.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F0E6"
      }
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F3F0E6",
          "dark": { "backgroundColor": "#1C1F1A" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
