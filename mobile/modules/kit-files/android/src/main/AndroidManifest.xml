<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <application>
    <!-- Android's downloader says a book is done, even with the app closed: see Books.kt -->
    <receiver android:name="expo.modules.kitfiles.BookDone" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
      </intent-filter>
    </receiver>
    <service
      android:name="expo.modules.kitfiles.BookCheck"
      android:exported="false"
      android:permission="android.permission.BIND_JOB_SERVICE" />
  </application>
</manifest>
