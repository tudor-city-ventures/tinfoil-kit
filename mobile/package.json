{
  "name": "tinfoilkit-mobile",
  "private": true,
  "description": "Tinfoil Kit for iPhone and Android: the kit's library, maps and AI on a phone, downloaded from the internet or copied from a kit on the home network.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint . && prettier --check src modules app.json eslint.config.js metro.config.js",
    "fix": "eslint --fix . && prettier --write src modules app.json eslint.config.js metro.config.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test -- --ci",
    "skills": "python3 skills.py"
  },
  "prettier": {
    "printWidth": 120
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@kesha-antonov/react-native-background-downloader": "5.1.0",
    "expo": "58.0.26",
    "expo-build-properties": "58.0.12",
    "expo-constants": "58.0.16",
    "expo-file-system": "58.0.14",
    "expo-linking": "58.0.17",
    "expo-network": "58.0.5",
    "expo-router": "58.0.32",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "expo-symbols": "58.0.5",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-import-resolver-typescript": "3.10.1",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  }
}
