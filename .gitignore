# What a checkout from before kit/ downloaded: the kit moves it into kit/ (kit/.gitignore) the next time it runs.
/downloads/
/data/
__pycache__/
.DS_Store
._*

# Test fixtures and runs (tests/build_fixtures.sh, tests/run_all.sh)
tests/work/

# Developer tools (npm ci --ignore-scripts, ruff)
node_modules/
.ruff_cache/

# The website's build (npm run build in site/) and its agent skills (npm run skills)
site/.next/
site/out/
site/.claude/

# The phone app's build, the native projects Expo generates from app.json, and its agent skills (npm run skills)
mobile/.expo/
mobile/dist/
mobile/ios/
mobile/android/
mobile/expo-env.d.ts
mobile/.claude/
.claude/settings.local.json

# What's new in the next release, for .github/release.sh vX.Y.Z NOTES.txt
/NOTES.txt
