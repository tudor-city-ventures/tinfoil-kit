# A checkout is its own app folder: what sync downloads goes in downloads/, the person's settings and the kit's
# records in data/. The rest are where a kit from before those folders kept them.
/downloads/
/data/
.kit/
logs/
bin/
models/
library/
maps/
installers/
INVENTORY.md
__pycache__/
.DS_Store
._*

# Test fixtures and runs (tests/build_fixtures.sh, tests/run_all.sh)
tests/work/

# Developer tools (npm ci --ignore-scripts, ruff)
node_modules/
.ruff_cache/

# The website's build (npm run build in site/) and its agent skills (npm run skills)
site/.next/
site/out/
site/.claude/
.claude/settings.local.json

# The kit's program, built by tools/tinfoilkit/build.sh (releases carry it; git doesn't)
tools/tinfoilkit-*

# What's new in the next release, for .github/release.sh vX.Y.Z NOTES.txt
/NOTES.txt
