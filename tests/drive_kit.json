{
  "settings": {
    "default_model": "Tiny",
    "context_size": 4096,
    "library_port": 18888,
    "ai_port": 18080,
    "data_port": 18095,
    "keep_free_gb": 0.1,
    "keep_free_gb_this_computer": 0.1,
    "keep_previous_runtime_versions": 1,
    "downloader": "curl",
    "pin_programs": false
  },
  "runtimes": [
    {
      "id": "llama.cpp-linux-x64",
      "type": "github",
      "repo": "ggml-org/llama.cpp",
      "asset": "llama-*-bin-ubuntu-x64.tar.gz",
      "binary": "llama-server"
    },
    {
      "id": "kiwix-tools-linux-x64",
      "type": "kiwix_release",
      "product": "kiwix-tools",
      "pattern": "kiwix-tools_linux-x86_64-{version}.tar.gz",
      "binary": "kiwix-serve"
    }
  ],
  "models": [
    {
      "id": "Tiny",
      "type": "hf",
      "repo": "test/Tiny-GGUF",
      "files": [
        "*-Q4_K_M.gguf",
        "mtp-*.gguf"
      ],
      "priority": 1,
      "note": "tiny test model, with a speculative decoding draft beside it as kits that had Gemma 4's do: the AI must not load it"
    },
    {
      "id": "Two",
      "type": "hf",
      "repo": "test/Two-GGUF",
      "files": [
        "*-Q4_K_M.gguf"
      ],
      "priority": 2
    },
    {
      "id": "Ambiguous",
      "type": "hf",
      "repo": "test/Tiny-GGUF",
      "files": [
        "Tiny-*.gguf"
      ]
    },
    {
      "id": "Missing",
      "type": "hf",
      "repo": "test/Nope-GGUF",
      "files": [
        "*.gguf"
      ]
    }
  ],
  "library": [
    {
      "zim": "testmed_en_all_maxi",
      "priority": 1,
      "note": "medical"
    },
    {
      "zim": "testsurvival_en",
      "priority": 1,
      "note": "survival"
    },
    {
      "zim": "does_not_exist_en",
      "priority": 3
    },
    {
      "zim": "disabled_one_en",
      "enabled": false
    }
  ],
  "extras": [
