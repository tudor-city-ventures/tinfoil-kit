* text=auto eol=lf
*.bat text eol=crlf
*.png binary
# Archives of the kit (a release, or Code > Download ZIP) stamp KIT_COMMIT in kit.py with their commit.
tools/kit.py export-subst
# Releases and Download ZIP carry the kit and nothing else: no tests, docs or website, except the two files of
# site/ the kit reads (kit.json's last version, for ./kit update's merge, and the builder's sizes, for estimate).
/tests export-ignore
/docs export-ignore
/.github export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/site/** export-ignore
/site/kit.json -export-ignore
/site/sources.json -export-ignore
