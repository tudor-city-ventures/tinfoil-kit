* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.icns binary
# Archives of the kit (a release, or Code > Download ZIP) write their commit into kit/tools/commit (./kit update reads
# it).
kit/tools/commit export-subst
# A release is kit/ with the license, README and THIRD-PARTY.md added (kit/tools/tinfoilkit/build.sh archive).
# Download ZIP carries the same, with the kit in kit/: no tests, docs, website, Mac app, phone app or developer tools.
/tests export-ignore
/docs export-ignore
/mac export-ignore
/mobile export-ignore
/.github export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/site export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/eslint.config.mjs export-ignore
/.editorconfig export-ignore
/ruff.toml export-ignore
/.git-blame-ignore-revs export-ignore
